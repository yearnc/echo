# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Android 签名与本地配置（Flutter 新模板未包含，必须手动加：绝不入库）
local.properties
/android/local.properties
/android/key.properties
key.properties
**/*.keystore
**/*.jks

# 环境变量与密钥文件
.env
.env.*
*.pem
*.key

# 第三方模型 API Key 只存在设备 Keystore 里，任何 fallback 配置文件都不入库
*secret*.json
*credentials*.json
