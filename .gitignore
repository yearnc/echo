# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Android 签名与本地配置（Flutter 新模板未包含，必须手动加：绝不入库）
local.properties
/android/local.properties
/android/key.properties
key.properties
**/*.keystore
**/*.jks

# 环境变量与密钥文件
.env
.env.*
*.pem
*.key

# 第三方模型 API Key 只存在设备 Keystore 里，任何 fallback 配置文件都不入库
*secret*.json
*credentials*.json

# 打包产物：APK 走 GitHub Release 发布，不进仓库
*.apk
*.aab
*.ipa

# 平台配置文件（Firebase 等），可能带项目标识
google-services.json
GoogleService-Info.plist

# 离线语音模型（B8 / v3.8）：几百兆的二进制，不进仓库——克隆下来的人照
# 各目录 _placeholder.txt 的说明自己放，放进去之后会被打进 APK。
/assets/models/tts/*
!/assets/models/tts/_placeholder.txt
/assets/models/zipvoice/*
!/assets/models/zipvoice/_placeholder.txt

# 临时放模型压缩包、验证脚本的地方（不属于项目内容）
/.models-tmp/

# 平台构建缓存（Flutter 模板的精简 .gitignore 没带这几条）
/android/.gradle/
/android/.kotlin/
**/windows/flutter/ephemeral/
**/ios/Flutter/ephemeral/
